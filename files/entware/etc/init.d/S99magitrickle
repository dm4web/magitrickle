#!/bin/sh

ENABLED=yes
PROG=/opt/bin/magitrickled
NAME=magitrickled
SSD=/opt/sbin/start-stop-daemon

is_running() {
	pidof "$NAME" >/dev/null 2>&1
}

start() {
	[ "$ENABLED" = yes ] || return 0
	if is_running; then
		echo "$NAME already running"
		return 0
	fi
	"$SSD" -S -b -x "$PROG" -O /dev/null || return 1
	sleep 1
	if ! is_running; then
		echo "$NAME failed to start" >&2
		return 1
	fi
	echo "$NAME started"
}

stop() {
	if ! is_running; then
		echo "$NAME already stopped"
		return 0
	fi
	"$SSD" -K -x "$PROG" || return 1
	i=0
	while is_running && [ "$i" -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	if is_running; then
		echo "$NAME failed to stop" >&2
		return 1
	fi
	echo "$NAME stopped"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop && start
		;;
	check|status)
		if is_running; then
			echo "$NAME running"
		else
			echo "$NAME stopped"
			exit 1
		fi
		;;
	reconfigure)
		killall -HUP "$NAME"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|check|status|reconfigure}" >&2
		exit 1
		;;
esac
